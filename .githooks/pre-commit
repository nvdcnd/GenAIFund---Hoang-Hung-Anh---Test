#!/usr/bin/env bash
# Gate local commits on the test suite. Bypass in emergencies with:
#   git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Cross-platform venv resolution (Windows vs POSIX layout).
if [ -x ".venv/Scripts/python.exe" ]; then
  PY=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
  PY=".venv/bin/python"
else
  PY="${PYTHON:-python3}"
fi

echo "pre-commit: running test suite with $PY ..."
"$PY" -m pytest tests/ -q
