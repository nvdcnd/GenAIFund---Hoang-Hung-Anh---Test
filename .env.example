# ── LLM ────────────────────────────────────────────────────────────────
# Leave OPENAI_API_KEY empty to run in deterministic MockLLM mode (zero-budget).
# Supported: openai/gpt-4o-mini, anthropic/claude-3-5-sonnet, etc. (LiteLLM-style prefixes)
LLM_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=

# ── LinkedIn Driver ────────────────────────────────────────────────────
# One of: mock | phantombuster | dripify | tinyfish
LINKEDIN_DRIVER=mock

PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_AGENT_ID=
DRIFIPI_API_KEY=
TINYFISH_API_KEY=

# ── Webhook / API server ───────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8001
WEBHOOK_SECRET=change-me

# ── Booking link shown to interested prospects ─────────────────────────
CALENDLY_LINK=https://cal.com/genai-fund/hackathon-sponsor

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/outreach.db
